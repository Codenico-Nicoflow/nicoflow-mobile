# Local dev: copy to .env and fill in. Never commit real values.
# In EAS builds these are set via `eas secret:create` (see README).
# On the Android EMULATOR this is rewritten to http://10.0.2.2:8080/v1
# automatically (see src/constants/resolveApiUrl.ts) — leave it as localhost.
# On a PHYSICAL Android device, set your machine's LAN address instead, e.g.
# http://192.168.1.20:8080/v1, and make sure the API listens on 0.0.0.0.
EXPO_PUBLIC_API_URL=http://localhost:8080/v1
EXPO_PUBLIC_POSTHOG_DSN=
EXPO_PUBLIC_SENTRY_DSN=
