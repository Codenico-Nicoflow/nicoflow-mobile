    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "fast-text-encoding": "^1.0.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "lint-staged": "^17.3.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "react-native-url-polyfill": "^4.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "zod": "^4.1.12",
    "lightningcss": "1.30.1"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./test/setup.ts"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/style-mock.js",
      "^@testing-library/react-native$": "<rootDir>/node_modules/@testing-library/react-native/dist/index.js"
    },
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ],
      "\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|lucide-react-native|@sentry/.*|posthog-react-native|msw|@mswjs|rettime|strict-event-emitter|is-node-process|@bundled-es-modules|@open-draft|outvariant|until-async|headers-polyfill|@nicoflow/shared|immer|react-redux|@reduxjs/toolkit|reselect|redux|standard-navigation|@testing-library/react-native)"
    ]
  }
}
